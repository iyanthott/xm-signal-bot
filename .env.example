MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_PING_URL=

# XM Signals website settings (optional). When XM_SETTINGS_TOKEN is set, the bot pulls its editable settings
# (markets, indicators, filters, SL/TP, alert options) from the website and applies new versions automatically.
# Create the token on the website: Bot connection (Super Admin). Leave blank to use config/settings.yaml only.
XM_SETTINGS_URL=https://pogingkita.stayatdiez.com
XM_SETTINGS_TOKEN=
# XM_SETTINGS_POLL_SECONDS=60

# Website sharing (optional, both OFF by default; they need XM_SETTINGS_TOKEN above).
# XM_PUBLISH_SIGNALS=1  also publish each alert you send to your Telegram to the website: it shows in your Feed, and reaches
#                       only the people you chose to share this bot with (Bots > your bot > Sharing).
# XM_FOLLOW_FEED=1      forward alerts shared by bots you FOLLOW (website > Feed) to YOUR OWN Telegram chat.
# XM_FEED_POLL_SECONDS=30

# W7 dashboard: report this bot's own account balance + trades to the website so they show on /dashboard.
# OFF by default per bot; set only the token for each bot you want on the dashboard. Each bot is its OWN
# website Bot (create with `npm run db:create-strategy-bots` in xm-web) - never reuse one bot's token for another.
# The main M15 bot reuses XM_SETTINGS_TOKEN above (same website Bot); M1 (in .env.m1) also uses XM_SETTINGS_TOKEN
# (a separate file, so no clash).
# XM_DIP_WEB_TOKEN=
# XM_TREND_WEB_TOKEN=
# XM_VBO_WEB_TOKEN=
# XM_CBO_WEB_TOKEN=

# --- Account-wide open-risk circuit breaker (src/trading_signal_bot/risk_guard.py), shared by ALL bots below ---
# Once total open risk across every bot (sum of risk_money for still-open trades in every data/*/trades.json)
# reaches this %% of balance, no bot opens a new trade (existing positions are never touched) until it drops
# back under. Set the SAME value for every bot - it's one account-wide cap, not a per-bot setting.
# XM_RISK_CAP_PCT=5

# --- Demo auto-trading, main bot (OFF unless set) ---
# XM_TRADE_ENABLED=1
# XM_TRADE_SYMBOLS=XAUUSD,NAS100
# XM_TRADE_RISK_PCT=1
# XM_TRADE_RR=1.5
# XM_TRADE_DAILY_LOSS_PCT=3

# --- Bot 3: Daily Dip (python -m trading_signal_bot.dip_bot; scripts\run_dip_bot.ps1). Demo accounts only. ---
# Buys sharp daily dips in US indices that are above their 200-day average; exits on the first close above
# the 5-day average or after XM_DIP_MAX_DAYS. Pause instantly: create data/dip/TRADING_PAUSED
# XM_DIP_ENABLED=1
# XM_DIP_MARKETS=US500=US500Cash,NAS100=US100Cash,GBP=GBPUSD,CA60=CA60Cash,SA40=SA40Cash
# XM_DIP_RISK_PCT=0.5
# XM_DIP_DAILY_LOSS_PCT=2
# XM_DIP_RSI2_BELOW=15
# Extra entry filter per market: signal bar must close in the bottom part of its range (IBS below the value).
# Unlisted markets are unfiltered; "off" disables it.
# XM_DIP_IBS_FILTER=US500=0.35,NAS100=0.35
# XM_DIP_STOP_ATR=2
# XM_DIP_MAX_DAYS=10

# --- Bot 4: Crypto Trend (python -m trading_signal_bot.trend_bot; scripts\run_trend_bot.ps1). Demo accounts only. ---
# Buys a daily close above the 55-day high / sells a close below the 55-day low on BTC and ETH; exits on a close
# through the opposite 20-day channel or after XM_TREND_MAX_DAYS. Pause instantly: create data/trend/TRADING_PAUSED
# XM_TREND_ENABLED=1
# XM_TREND_MARKETS=BTC=BTCUSD,ETH=ETHUSD,JP225=JP225Cash,NFLX=Netflix
# XM_TREND_RISK_PCT=0.5
# XM_TREND_DAILY_LOSS_PCT=2
# XM_TREND_ENTRY_DAYS=55
# XM_TREND_EXIT_DAYS=20
# XM_TREND_STOP_ATR=2
# XM_TREND_MAX_DAYS=120
# XM_TREND_LONG_ONLY=0

# --- Bot 5: Volatility Breakout (python -m trading_signal_bot.vbo_bot; scripts\run_vbo_bot.ps1). Demo accounts only. ---
# Stop order at today's open +/- XM_VBO_K x yesterday's range on ETH, filled intraday; exits on the broker-side
# ATR stop or after XM_VBO_MAX_DAYS. Pause instantly: create data/vbo/TRADING_PAUSED
# XM_VBO_ENABLED=1
# XM_VBO_MARKETS=ETH=ETHUSD,BRENT=BRENTCash,OIL=OILCash
# XM_VBO_RISK_PCT=0.5
# XM_VBO_DAILY_LOSS_PCT=2
# XM_VBO_K=0.5
# XM_VBO_STOP_ATR=2
# XM_VBO_MAX_DAYS=5

# --- Bot 6: Candle Breakout (python -m trading_signal_bot.cbo_bot; scripts\run_cbo_bot.ps1). Demo accounts only. ---
# Same 55-day breakout as Bot 4, gated on the trigger bar being a strong-bodied candle; traded on GOLD only.
# Exits on a close through the opposite 20-day channel or after XM_CBO_MAX_DAYS. Pause instantly: create
# data/cbo/TRADING_PAUSED
# XM_CBO_ENABLED=1
# XM_CBO_MARKETS=GOLD=GOLD,NVDA=Nvidia
# XM_CBO_RISK_PCT=0.5
# XM_CBO_DAILY_LOSS_PCT=2
# XM_CBO_ENTRY_DAYS=55
# XM_CBO_EXIT_DAYS=20
# XM_CBO_STOP_ATR=2
# XM_CBO_MAX_DAYS=120

# --- Bot 7: Fresh-Breakout Dip (python -m trading_signal_bot.fbd_bot; scripts\run_fbd_bot.ps1). Demo accounts only. ---
# Buys a sharp dip (RSI(2) < 10) right after a fresh 20-day high, above the 50-day average, on JPY crosses; exits
# on the first close above the previous day's high or after XM_FBD_MAX_DAYS. Pause instantly: create
# data/fbd/TRADING_PAUSED
# XM_FBD_ENABLED=1
# XM_FBD_MARKETS=CHFJPY=CHFJPY,GBPJPY=GBPJPY,EURJPY=EURJPY
# XM_FBD_RISK_PCT=0.5
# XM_FBD_DAILY_LOSS_PCT=2
# XM_FBD_RSI2_BELOW=10
# XM_FBD_STOP_ATR=2
# XM_FBD_MAX_DAYS=5
# XM_FBD_WEB_TOKEN=

# --- Bot 8: Open Gap Fade (python -m trading_signal_bot.gap_bot; scripts\run_gap_bot.ps1). Demo accounts only. ---
# At the 16:30 server US cash open, trades AGAINST an overnight move >= XM_GAP_ATR_MULT x daily ATR% on NAS100;
# stop XM_GAP_STOP_ATR x ATR%, closes at 19:00 server. Entries only within XM_GAP_ENTRY_WINDOW_SEC of 16:30.
# Every fill is logged vs the 16:30 open in data/gap/fills.csv. Pause instantly: create data/gap/TRADING_PAUSED
# XM_GAP_ENABLED=1
# XM_GAP_MARKETS=NAS100=US100Cash
# XM_GAP_RISK_PCT=0.5
# XM_GAP_DAILY_LOSS_PCT=2
# XM_GAP_ATR_MULT=0.75
# XM_GAP_STOP_ATR=1
# XM_GAP_ENTRY_WINDOW_SEC=120
# XM_GAP_WEB_TOKEN=
