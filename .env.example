MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_PING_URL=

# XM Signals website settings (optional). When XM_SETTINGS_TOKEN is set, the bot pulls its editable settings
# (markets, indicators, filters, SL/TP, alert options) from the website and applies new versions automatically.
# Create the token on the website: Bot connection (Super Admin). Leave blank to use config/settings.yaml only.
XM_SETTINGS_URL=https://pogingkita.stayatdiez.com
XM_SETTINGS_TOKEN=
# XM_SETTINGS_POLL_SECONDS=60

# Website sharing (optional, both OFF by default; they need XM_SETTINGS_TOKEN above).
# XM_PUBLISH_SIGNALS=1  also publish each alert you send to your Telegram to the website: it shows in your Feed, and reaches
#                       only the people you chose to share this bot with (Bots > your bot > Sharing).
# XM_FOLLOW_FEED=1      forward alerts shared by bots you FOLLOW (website > Feed) to YOUR OWN Telegram chat.
# XM_FEED_POLL_SECONDS=30
